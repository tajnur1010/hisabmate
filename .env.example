# ─────────────────────────────────────────────────────────────
# HisabMate environment configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit your real .env file. NEVER put a service-role key here —
# only the public "anon" key belongs in a frontend app.
# ─────────────────────────────────────────────────────────────

# Data backend: "mock" (offline, in-browser demo data) or "supabase" (live).
# Leave as "mock" to run the app instantly with no backend.
VITE_DATA_BACKEND=mock

# Supabase — required only when VITE_DATA_BACKEND=supabase.
# Find these in your Supabase project: Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: enable Google OAuth button (configure the provider in Supabase first).
VITE_ENABLE_GOOGLE_AUTH=false

# Optional: default language on first load — "bn" (Bangla) or "en" (English).
VITE_DEFAULT_LANG=bn

# Optional: default currency symbol shown in the UI.
VITE_DEFAULT_CURRENCY=৳

# Required for the Android app build only. The packaged app's own address is
# http://localhost, which no email client can open — so password-reset and OAuth
# links must point at the deployed site instead. Must match the Site URL /
# Redirect URL configured in Supabase → Authentication → URL Configuration.
VITE_PUBLIC_URL=https://hisabmate-nu.vercel.app
