# dependencies
node_modules
.pnp
.pnp.js

# build output
dist
dist-ssr
*.local
dev-dist

# native app projects — generated from capacitor.config.ts by `npx cap add`,
# so they are rebuilt on demand instead of being committed. Keeping them out
# means no huge generated diffs and no stale native files.
/android
/ios
.gradle
*.apk
*.aab
*.keystore
*.jks

# env — never commit real keys
.env
.env.local
.env.*.local

# editor / os
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs
*.log
